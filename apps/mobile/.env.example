# Mobile-specific env. Real values in .env.dev / .env.prod (gitignored).
# See ~/productivity/standards/env-files.md.
#
# EXPO_PUBLIC_* vars are baked into the JS bundle and visible in the app —
# never put secrets here. Server-side secrets live on the OCI VM only.

APP_ENV=preview
EXPO_PUBLIC_API_URL=https://server.getsetmvp.com
EXPO_PUBLIC_TENANT=voxpense
EXPO_PUBLIC_SENTRY_DSN=

OTA_SERVER_URL=https://ota-server.yashguptadeveloper.workers.dev
