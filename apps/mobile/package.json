{
  "name": "@voxpense/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "android:preview": "cross-env APP_ENV=preview expo run:android",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "bundle": "expo export --experimental-bundle --platform android",
    "ota:prepare": "node scripts/prepare-bundles.js",
    "ota:build": "pnpm bundle && pnpm ota:prepare",
    "ota:next-version": "node scripts/next-version.js",
    "ota:upload": "node scripts/upload-to-r2.js",
    "ota:publish": "pnpm ota:build && pnpm ota:upload",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^14.0.4",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.100.14",
    "@voxpense/shared-types": "workspace:*",
    "date-fns": "^4.4.0",
    "expo": "~53.0.0",
    "expo-blur": "^14.1.5",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image": "~2.4.1",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-speech-recognition": "^1.1.0",
    "expo-splash-screen": "~0.30.0",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.0",
    "lucide-react-native": "^0.460.0",
    "nativewind": "^4.1.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-css-interop": "^0.2.4",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-worklets": "^0.5.1",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.0.0",
    "eas-cli": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.6.0"
  }
}
