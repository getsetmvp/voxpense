# Build / publish env. App-level. Real values in .env.dev / .env.prod (gitignored).
# See ~/productivity/standards/env-files.md

# ── OTA publish pipeline (used by scripts/upload-to-r2.js + ota-publish.yaml) ────
APP_NAME=voxpense
OTA_SERVER_URL=https://ota-server.yashguptadeveloper.workers.dev
R2_PUBLIC_URL=https://<account-id>.r2.cloudflarestorage.com/ota-bundles

# ── Cloudflare (R2 write, used by wrangler r2 object put) ───────────────────────
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me

# ── GitHub PAT for dispatching ota-server's update-version workflow ─────────────
OTA_REPO_TOKEN=replace_me

# ── EAS Build auth ──────────────────────────────────────────────────────────────
EXPO_TOKEN=replace_me

# ── Mobile runtime env (EXPO_PUBLIC_* baked into bundle) ────────────────────────
# These also live in apps/mobile/.env.example for direct Expo reads
EXPO_PUBLIC_API_URL=https://server.getsetmvp.com
EXPO_PUBLIC_TENANT=voxpense
EXPO_PUBLIC_SENTRY_DSN=
