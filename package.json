{
  "name": "@yashguptadeveloper/voxpense",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first personal expense tracker. Speak it → AI parses → categorized expense saved.",
  "license": "UNLICENSED",
  "author": "Yash Gupta <yash.gupta.developer@gmail.com>",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @voxpense/mobile dev",
    "dev:web": "pnpm --filter @voxpense/web dev",
    "build:web": "pnpm --filter @voxpense/web build",
    "android": "pnpm --filter @voxpense/mobile android",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "ota:build": "pnpm --filter @voxpense/mobile ota:build",
    "ota:upload": "pnpm --filter @voxpense/mobile ota:upload",
    "ota:publish": "pnpm --filter @voxpense/mobile ota:publish"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.9.16",
    "typescript": "~5.6.0"
  }
}
